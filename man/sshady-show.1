.TH "SSHADY" "1" "Jul 2026" "sshady dev" "sshady Manual"

.SH NAME
sshady-show - Show full details of an SSH proxy configuration


.SH SYNOPSIS
\fBsshady show  [flags]\fP


.SH DESCRIPTION
Show every field of an entry managed by sshady, including the
exact block written to ~/.ssh/config.

.PP
Proxy passwords are masked unless --reveal is given.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for show

.PP
\fB--reveal\fP[=false]
	show proxy password in plaintext


.SH EXAMPLE
.EX
  sshady show myserver
  sshady show myserver --reveal
.EE


.SH SEE ALSO
\fBsshady(1)\fP


