.TH "SSHADY" "1" "Jul 2026" "sshady dev" "sshady Manual"

.SH NAME
sshady-create - Create a new SSH proxy configuration


.SH SYNOPSIS
\fBsshady create [flags]\fP


.SH DESCRIPTION
Create a new SSH Host entry with proxy settings.

.PP
Without flags, launches the interactive wizard.
Provide --alias, --host, and --proxy-type (plus proxy-specific flags) to skip the wizard.


.SH OPTIONS
\fB--alias\fP=""
	SSH host alias

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--host\fP=""
	target hostname or IP

.PP
\fB--identity-file\fP=""
	SSH identity file path

.PP
\fB--jump-host\fP=""
	SSH jump host (user@host)

.PP
\fB--port\fP="22"
	SSH port

.PP
\fB--proxy-host\fP=""
	proxy hostname or IP

.PP
\fB--proxy-pass\fP=""
	proxy password

.PP
\fB--proxy-port\fP="1080"
	proxy port

.PP
\fB--proxy-type\fP=""
	proxy type: socks5, http, tor, jump

.PP
\fB--proxy-user\fP=""
	proxy username

.PP
\fB--user\fP=""
	SSH user


.SH EXAMPLE
.EX
  sshady create
  sshady create --alias web --host 1.2.3.4 --proxy-type tor
  sshady create --alias web --host 1.2.3.4 --proxy-type socks5 \\
    --proxy-host proxy.example.com --proxy-port 1080 \\
    --proxy-user alice --proxy-pass s3cr3t
  sshady create --alias internal --host 10.0.0.5 --proxy-type jump \\
    --jump-host bastion@192.168.1.1
.EE


.SH SEE ALSO
\fBsshady(1)\fP


