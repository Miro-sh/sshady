.TH "SSHADY" "1" "Jul 2026" "sshady dev" "sshady Manual"

.SH NAME
sshady-edit - Edit an existing SSH proxy configuration


.SH SYNOPSIS
\fBsshady edit  [flags]\fP


.SH DESCRIPTION
Edit an entry previously created by sshady.

.PP
Without flags, launches the interactive wizard pre-filled with the
current values (leave the proxy password empty to keep it).

.PP
With flags, only the given fields are updated.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for edit

.PP
\fB--host\fP=""
	target hostname or IP

.PP
\fB--identity-file\fP=""
	SSH identity file path (empty string to clear)

.PP
\fB--jump-host\fP=""
	SSH jump host (user@host)

.PP
\fB--port\fP=""
	SSH port

.PP
\fB--proxy-host\fP=""
	proxy hostname or IP

.PP
\fB--proxy-pass\fP=""
	proxy password

.PP
\fB--proxy-port\fP=""
	proxy port

.PP
\fB--proxy-type\fP=""
	proxy type: socks5, http, tor, jump

.PP
\fB--proxy-user\fP=""
	proxy username

.PP
\fB--user\fP=""
	SSH user


.SH EXAMPLE
.EX
  sshady edit myserver
  sshady edit myserver --port 443
  sshady edit myserver --proxy-type tor
  sshady edit myserver --proxy-user alice --proxy-pass s3cr3t
.EE


.SH SEE ALSO
\fBsshady(1)\fP


