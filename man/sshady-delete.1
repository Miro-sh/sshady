.TH "SSHADY" "1" "Jul 2026" "sshady dev" "sshady Manual"

.SH NAME
sshady-delete - Delete an SSH proxy configuration


.SH SYNOPSIS
\fBsshady delete  [flags]\fP


.SH DESCRIPTION
Delete an entry managed by sshady from ~/.ssh/config.

.PP
Asks for confirmation unless --force is given.
A backup is written to ~/.ssh/config.sshady.bak before every change.


.SH OPTIONS
\fB-f\fP, \fB--force\fP[=false]
	delete without confirmation

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for delete


.SH EXAMPLE
.EX
  sshady delete myserver
  sshady delete myserver --force
.EE


.SH SEE ALSO
\fBsshady(1)\fP


